# Supabase → Connect → Direct → Session pooler（port 5432）
# scheme 改成 postgresql+psycopg://，結尾加 ?sslmode=require；密碼含特殊字元需 URL encode
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=change-me
# 逗號分隔的前端網址；未設定時允許全部（本機開發）
CORS_ORIGINS=http://localhost:3100
